#!/bin/zsh

set -e

SCRIPT_PATH="${0:A}"
SCRIPT_DIR="${SCRIPT_PATH:h}"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [[ -f "$PROJECT_ROOT/.env" ]]; then
  export AI_HARNESS_ENV_FILE="$PROJECT_ROOT/.env"
fi

needs_gui=false
for argument in "$@"; do
  if [[ "$argument" == "--gui" ]]; then
    needs_gui=true
    break
  fi
done

for environment in "$PROJECT_ROOT/.venv" "$PROJECT_ROOT/.venv-mac"; do
  python_bin="$environment/bin/python"
  harness_bin="$environment/bin/ai-harness"
  [[ -x "$python_bin" && -x "$harness_bin" ]] || continue
  "$python_bin" -c 'import openai, playwright' >/dev/null 2>&1 || continue
  if $needs_gui; then
    "$python_bin" -c 'import PIL, tkinter' >/dev/null 2>&1 || continue
  fi
  exec "$harness_bin" "$@"
done

if $needs_gui; then
  echo "找不到依赖完整的 AI Harness GUI 环境；请运行 python -m pip install -e \".[dev]\"。" >&2
else
  echo "找不到可用的 AI Harness 虚拟环境；请先创建并安装 .venv。" >&2
fi
exit 1
