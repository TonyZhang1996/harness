# Copy this file to .env or ~/.ai-harness/.env and replace the placeholder locally.
DEEPSEEK_API_KEY="replace-me"
AI_HARNESS_MODEL="deepseek-v4-flash"

# Generic OpenAI-compatible endpoint:
# AI_HARNESS_API_KEY="replace-me"
# AI_HARNESS_BASE_URL="https://example.com/v1"
# AI_HARNESS_MODEL="model-name"
# AI_HARNESS_TIMEOUT="60"

# Image attachments are sent to a vision-capable model first, then the result
# is passed to the configured text model. By default the plugin reuses the
# text endpoint and discovers a vision model through /models.
# AI_HARNESS_VISION_ENABLED="true"
# AI_HARNESS_VISION_MODEL="qwen-vl-max"
# AI_HARNESS_VISION_CANDIDATES="qwen-vl-max,qwen-vl-plus,gpt-4o"
# AI_HARNESS_VISION_BASE_URL="https://example.com/v1"
# AI_HARNESS_VISION_API_KEY="replace-me"
# AI_HARNESS_VISION_AUTO_DISCOVER="true"
# AI_HARNESS_VISION_TIMEOUT="60"
# AI_HARNESS_VISION_MAX_IMAGE_BYTES="20000000"

# OpenCode Go (the base URL and default model are inferred):
# OPENCODE_GO_API_KEY="replace-me"
# AI_HARNESS_PROVIDER="opencode-go"
# AI_HARNESS_MODEL="deepseek-v4-flash"
