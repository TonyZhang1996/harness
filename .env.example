# Copy this file to .env or ~/.ai-harness/.env and replace the placeholder locally.
DEEPSEEK_API_KEY="replace-me"
AI_HARNESS_MODEL="deepseek-v4-flash"

# Generic OpenAI-compatible endpoint:
# AI_HARNESS_API_KEY="replace-me"
# AI_HARNESS_BASE_URL="https://example.com/v1"
# AI_HARNESS_MODEL="model-name"
# AI_HARNESS_TIMEOUT="60"

# OpenCode Go (the base URL and default model are inferred):
# OPENCODE_GO_API_KEY="replace-me"
# AI_HARNESS_PROVIDER="opencode-go"
# AI_HARNESS_MODEL="deepseek-v4-flash"
